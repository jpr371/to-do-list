<%- include('partials/app-start', { pageTitle, activePage }) %>
<% const filtersActive = Boolean(filters.q || filters.status || filters.priority || filters.category || filters.due); const closeHref = filters.view === 'category' ? '/tasks?view=category' : '/tasks'; %>
<form class="toolbar" method="get" data-filters>
  <% if (filters.view === 'category') { %><input type="hidden" name="view" value="category"><% } %>
  <label class="searchbox"><%- icon('search','sm') %><input id="taskSearch" name="q" placeholder="Buscar tarefas..." value="<%= filters.q %>" type="search"><span class="kbd">/</span></label>
  <label class="select-wrap"><%- icon('activity') %><select class="select-sm <%= filters.status ? 'on' : '' %>" name="status"><option value="">Todos os status</option><% Object.entries(statuses).forEach(([k,v]) => { %><option value="<%= k %>" <%= filters.status === k ? 'selected' : '' %>><%= v %></option><% }) %></select></label>
  <label class="select-wrap"><%- icon('flag') %><select class="select-sm <%= filters.priority ? 'on' : '' %>" name="priority"><option value="">Toda prioridade</option><% Object.entries(priorities).forEach(([k,v]) => { %><option value="<%= k %>" <%= filters.priority === k ? 'selected' : '' %>><%= v %></option><% }) %></select></label>
  <label class="select-wrap"><%- icon('tag') %><select class="select-sm <%= filters.category ? 'on' : '' %>" name="category"><option value="">Toda categoria</option><% categories.forEach(cat => { %><option value="<%= cat.category %>" <%= filters.category === cat.category ? 'selected' : '' %>><%= cat.category %></option><% }) %><option value="__none__" <%= filters.category === '__none__' ? 'selected' : '' %>>Sem categoria</option></select></label>
  <label class="select-wrap"><%- icon('calendar') %><select class="select-sm <%= filters.due ? 'on' : '' %>" name="due"><option value="">Qualquer prazo</option><option value="overdue" <%= filters.due === 'overdue' ? 'selected' : '' %>>Atrasadas</option><option value="today" <%= filters.due === 'today' ? 'selected' : '' %>>Hoje</option><option value="upcoming" <%= filters.due === 'upcoming' ? 'selected' : '' %>>Próximos 7 dias</option><option value="none" <%= filters.due === 'none' ? 'selected' : '' %>>Sem prazo</option></select></label>
  <button class="btn btn-ghost btn-sm" type="submit" data-filter-submit><%- icon('filter','sm') %>Filtrar</button>
  <% if (filtersActive) { %><a class="btn btn-ghost btn-sm" href="<%= closeHref %>"><%- icon('x','sm') %>Limpar filtros</a><% } %>
</form>

<% if (filters.view === 'category') { %>
  <% if (!Object.keys(grouped).length) { %><div class="tasklist"><div class="empty"><div class="ic-big"><%- icon('tag') %></div><h3>Nenhuma categoria encontrada</h3><p>Crie uma tarefa com categoria para ela aparecer aqui.</p><a class="btn btn-primary" style="margin-top:20px" href="/tasks?action=new"><%- icon('plus','sm') %>Nova tarefa</a></div></div><% } %>
  <div class="cat-grid">
    <% Object.entries(grouped).forEach(([categoryName, categoryTasks]) => { const catTotal = categoryTasks.length; const catDone = categoryTasks.filter(t => t.status === 'done').length; const catPct = catTotal ? Math.round(catDone / catTotal * 100) : 0; %>
      <section class="cat-group open" style="--c:<%= catColor(categoryName) %>">
        <div class="cat-head"><div class="l"><span class="cat-swatch"><%= categoryName[0].toUpperCase() %></span><div><span class="name"><%= categoryName %></span><span class="count"><%= catTotal %> tarefa<%= catTotal === 1 ? '' : 's' %> · <%= catPct %>% feito</span></div></div><a class="panel-link" href="/tasks?category=<%= encodeURIComponent(categoryName === 'Sem categoria' ? '__none__' : categoryName) %>">Ver<%- icon('arrow-right') %></a></div>
        <div class="cat-progress"><i style="width:<%= catPct %>%"></i></div>
        <div class="cat-body"><% categoryTasks.forEach(task => { %><a class="cat-task" href="/tasks?view=category&action=view&id=<%= task.id %>"><span class="tt"><%= task.title %></span><%- statusPill(task.status) %></a><% }) %></div>
      </section>
    <% }) %>
  </div>
<% } else { %>
  <form method="post" data-bulk>
    <input type="hidden" name="action" value="bulk_status">
    <div class="bulkbar" data-bulkbar><span class="sel-count"><%- icon('check-circle','sm') %><span data-sel-count>0 selecionadas</span></span><select class="select-sm" name="bulk_status"><% Object.entries(statuses).forEach(([k,v]) => { %><option value="<%= k %>"><%= v %></option><% }) %></select><button class="btn btn-primary btn-sm" type="submit"><%- icon('check','sm') %>Aplicar</button></div>
    <div class="tasklist">
      <div class="trow head"><div><% if (tasks.length) { %><input type="checkbox" data-check-all aria-label="Selecionar todas"><% } %></div><div>Tarefa</div><div class="col-status">Status</div><div class="col-pri">Prioridade</div><div class="col-cat">Categoria</div><div class="col-due">Prazo</div><div></div></div>
      <% if (!tasks.length) { %><div class="empty"><div class="ic-big"><%- icon(filtersActive ? 'search' : 'inbox') %></div><h3><%= filtersActive ? 'Nada encontrado' : 'Página em branco' %></h3><p><%= filtersActive ? 'Tente ajustar a busca ou remover alguns filtros.' : 'Crie sua primeira tarefa para começar a organizar seu trabalho.' %></p><a class="btn btn-primary" style="margin-top:20px" href="/tasks?action=new"><%- icon('plus','sm') %>Nova tarefa</a></div><% } %>
      <% tasks.forEach(task => { const catName = task.category || ''; %>
        <div class="trow <%= task.status === 'done' ? 'is-done' : '' %>" data-task-row>
          <div><input type="checkbox" class="row-check" name="ids[]" value="<%= task.id %>" aria-label="Selecionar tarefa"></div>
          <div class="title-cell"><a class="tt" href="/tasks?action=view&id=<%= task.id %>"><%= task.title %></a><div class="dd"><%= truncate(task.description || 'Sem descrição', 80) %></div></div>
          <div class="col-status"><%- statusPill(task.status) %></div>
          <div class="col-pri"><%- priorityPill(task.priority) %></div>
          <div class="col-cat"><span class="cat-tag <%= !catName ? 'none' : '' %>" style="--c:<%= catColor(catName || 'Sem categoria') %>"><i></i><span><%= catName || 'Sem categoria' %></span></span></div>
          <div class="col-due"><span class="due-cell <%= dueCss(task.due_date, task.status) %>"><%- icon('calendar') %><%= dueLabel(task.due_date, task.status) %></span></div>
          <div class="row-actions"><a class="row-open" href="/tasks?action=view&id=<%= task.id %>" aria-label="Abrir tarefa" title="Abrir"><%- icon('arrow-right') %></a></div>
          <div class="row-meta"><%- statusPill(task.status) %><%- priorityPill(task.priority) %><% if (task.due_date) { %><span class="due-cell <%= dueCss(task.due_date, task.status) %>"><%- icon('calendar') %><%= dueLabel(task.due_date, task.status) %></span><% } %></div>
        </div>
      <% }) %>
    </div>
  </form>
<% } %>

<% if (detailTask) { %>
<div class="overlay show" id="overlayDetail" data-close-href="<%= closeHref %>">
  <div class="sidepanel" role="dialog" aria-modal="true">
    <a class="panel-close" href="<%= closeHref %>" aria-label="Fechar"><%- icon('x') %></a>
    <div style="display:flex;gap:6px;flex-wrap:wrap"><%- statusPill(detailTask.status) %><%- priorityPill(detailTask.priority) %></div>
    <h2 style="margin-top:16px"><%= detailTask.title %></h2>
    <div class="panel-eyebrow"><%- icon('pencil') %>Descrição</div>
    <div class="desc-block <%= !detailTask.description ? 'muted' : '' %>"><%= detailTask.description || 'Sem descrição adicionada.' %></div>
    <div class="detail-grid">
      <div class="d"><div class="k"><%- icon('flag') %>Prioridade</div><div class="v"><%= priorities[detailTask.priority] %></div></div>
      <div class="d"><div class="k"><%- icon('tag') %>Categoria</div><div class="v"><%= detailTask.category || 'Sem categoria' %></div></div>
      <div class="d"><div class="k"><%- icon('calendar') %>Prazo</div><div class="v <%= dueCss(detailTask.due_date, detailTask.status) %>"><%= dueLabel(detailTask.due_date, detailTask.status) %></div></div>
      <div class="d"><div class="k"><%- icon('clock') %>Criada em</div><div class="v"><%= formatDateTime(detailTask.created_at) %></div></div>
      <div class="d" style="grid-column:1/3"><div class="k"><%- icon('rotate') %>Última atualização</div><div class="v"><%= formatDateTime(detailTask.updated_at) %></div></div>
    </div>
    <div class="panel-foot">
      <button class="btn btn-danger btn-sm spacer" type="button" data-delete-task="<%= detailTask.id %>"><%- icon('trash','sm') %>Excluir</button>
      <% if (detailTask.status === 'done') { %><form method="post"><input type="hidden" name="action" value="reopen"><input type="hidden" name="id" value="<%= detailTask.id %>"><button class="btn btn-ghost btn-sm" type="submit"><%- icon('rotate','sm') %>Reabrir</button></form><% } else { %><button class="btn btn-ghost btn-sm" type="button" data-quick-done="<%= detailTask.id %>"><%- icon('check','sm') %>Concluir</button><% } %>
      <a class="btn btn-primary btn-sm" href="/tasks?action=edit&id=<%= detailTask.id %>"><%- icon('pencil','sm') %>Editar</a>
    </div>
  </div>
</div>
<% } %>

<% if (modalOpen) { const task = editTask || {}; %>
<div class="overlay show" data-close-href="/tasks">
  <div class="sidepanel" role="dialog" aria-modal="true">
    <a class="panel-close" href="/tasks" aria-label="Fechar"><%- icon('x') %></a>
    <div class="panel-eyebrow"><%- icon(editTask ? 'pencil' : 'sparkle') %><%= editTask ? 'Editando' : 'Nova página' %></div>
    <h2><%= editTask ? 'Editar tarefa' : 'Nova tarefa' %></h2>
    <form method="post" id="taskForm">
      <input type="hidden" name="action" value="save"><input type="hidden" name="id" value="<%= task.id || '' %>">
      <div class="field"><label for="f-title"><%- icon('pencil') %>Título</label><input id="f-title" name="title" maxlength="120" value="<%= task.title || '' %>" placeholder="Ex: Preparar apresentação do trimestre" required autofocus></div>
      <div class="field"><label for="f-desc"><%- icon('list') %>Descrição</label><textarea id="f-desc" name="description" placeholder="Detalhes, links, próximos passos..."><%= task.description || '' %></textarea></div>
      <div class="two-col">
        <div class="field"><label for="f-cat"><%- icon('tag') %>Categoria</label><input id="f-cat" name="category" maxlength="60" list="categorySuggestions" value="<%= task.category || '' %>" placeholder="Trabalho"></div>
        <div class="field"><label for="f-pri"><%- icon('flag') %>Prioridade</label><select id="f-pri" name="priority"><% Object.entries(priorities).forEach(([k,v]) => { %><option value="<%= k %>" <%= (task.priority || 'normal') === k ? 'selected' : '' %>><%= v %></option><% }) %></select></div>
      </div>
      <datalist id="categorySuggestions"><% categories.forEach(cat => { %><option value="<%= cat.category %>"><% }) %></datalist>
      <div class="two-col">
        <div class="field"><label for="f-status"><%- icon('activity') %>Status</label><select id="f-status" name="status"><% Object.entries(statuses).forEach(([k,v]) => { %><option value="<%= k %>" <%= (task.status || 'inbox') === k ? 'selected' : '' %>><%= v %></option><% }) %></select></div>
        <div class="field"><label for="f-due"><%- icon('calendar') %>Prazo</label><input id="f-due" type="date" name="due_date" value="<%= task.due_date ? new Date(task.due_date).toISOString().slice(0,10) : '' %>"></div>
      </div>
    </form>
    <div class="panel-foot"><a class="btn btn-ghost" href="/tasks"><%- icon('x','sm') %>Cancelar</a><button class="btn btn-primary" type="submit" form="taskForm"><%- icon('check','sm') %>Salvar tarefa</button></div>
  </div>
</div>
<% } %>

<form method="post" id="deleteForm" hidden><input type="hidden" name="action" value="delete"><input type="hidden" name="id" id="deleteTaskId"></form>
<%- include('partials/app-end') %>

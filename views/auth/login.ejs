<!doctype html>
<html lang="pt-BR">
<head><%- include('../partials/head', { headTitle: 'Entrar - TaskFlow' }) %></head>
<body>
<div id="toastwrap"></div>
<div class="theme-float"><%- themeToggle() %></div>
<section class="screen" id="screen-login">
  <div class="auth-wrap">
    <div class="auth-side">
      <div class="mark"><%- brandMark() %>TaskFlow</div>
      <div>
        <h1>Organize seu trabalho. <em>Recupere seu tempo.</em></h1>
        <p class="quote">Tarefas, prazos e prioridades num só caderno, do primeiro rascunho à entrega.</p>
        <div class="auth-preview" aria-hidden="true">
          <div class="ap-row done"><span class="ap-chk on"><%- icon('check') %></span><span class="t">Revisar proposta do cliente</span><span class="ap-tag ok"><%- icon('check','xs') %>Feito</span></div>
          <div class="ap-row"><span class="ap-chk"></span><span class="t">Preparar apresentação</span><span class="ap-tag hot"><%- icon('zap','xs') %>Hoje</span></div>
          <div class="ap-row"><span class="ap-chk"></span><span class="t">Planejar próxima sprint</span><span class="ap-tag"><%- icon('calendar','xs') %>Sex</span></div>
        </div>
      </div>
      <p class="foot">© 2026 TaskFlow</p>
    </div>
    <div class="auth-form-col">
      <div class="auth-box">
        <a class="mark mark-mobile" href="/login"><%- brandMark() %>TaskFlow</a>
        <div class="eyebrow">Entrar</div>
        <h2>Bem-vindo <em>de volta.</em></h2>
        <p class="sub">Entre para continuar de onde parou.</p>
        <% if (registered || flash?.success) { %><div class="auth-banner success-banner"><%- icon('check-circle','sm') %><%= flash?.success || 'Conta criada. Entre com seu e-mail e senha.' %></div><% } %>
        <% if (error) { %><div class="auth-banner"><%- icon('alert','sm') %><%= error %></div><% } %>
        <form class="auth-card" method="post" autocomplete="on">
          <div class="field"><label for="identifier"><%- icon('user') %>E-mail ou usuário</label><div class="input-ic"><%- icon('mail') %><input id="identifier" name="identifier" autocomplete="username" placeholder="voce@empresa.com" value="<%= old.identifier || '' %>" required autofocus></div></div>
          <div class="field"><label for="password"><%- icon('lock') %>Senha</label><div class="pw-wrap input-ic"><%- icon('lock') %><input id="password" name="password" type="password" autocomplete="current-password" placeholder="Sua senha" required><button type="button" data-show-password>Mostrar</button></div></div>
          <button class="btn btn-primary btn-block" type="submit">Entrar<%- icon('arrow-right','sm') %></button>
        </form>
        <p class="auth-foot">Ainda não tem conta? <a href="/register">Criar conta</a></p>
      </div>
    </div>
  </div>
</section>
<script src="/js/app.js"></script>
</body>
</html>

<div class="overlay center" id="overlayConfirm">
  <div class="modal-box" role="dialog" aria-modal="true" aria-labelledby="confirmTitle">
    <div class="ic-danger"><%- icon('alert') %></div>
    <h3 id="confirmTitle" data-confirm-title-out>Confirmar ação?</h3>
    <p data-confirm-text-out></p>
    <div class="row"><button class="btn btn-ghost" type="button" data-confirm-dismiss>Cancelar</button><button class="btn btn-danger" type="button" data-confirm-accept>Confirmar</button></div>
  </div>
</div>

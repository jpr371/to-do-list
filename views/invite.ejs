<!doctype html>
<html lang="pt-BR">
<head><%- include('partials/head', { headTitle: 'Convite - TaskFlow' }) %></head>
<body>
<div class="theme-float"><%- themeToggle() %></div>
<section class="screen" id="screen-invite">
  <div class="auth-wrap">
    <div class="auth-side">
      <div class="mark"><%- brandMark() %>TaskFlow</div>
      <div>
        <h1>Trabalhe em equipe <em>no mesmo caderno.</em></h1>
        <p class="quote">Tarefas, responsáveis e prazos da equipe num só lugar.</p>
      </div>
      <p class="foot">© 2026 TaskFlow</p>
    </div>
    <div class="auth-form-col">
      <div class="auth-box">
        <a class="mark mark-mobile" href="/login"><%- brandMark() %>TaskFlow</a>
        <div class="eyebrow">Convite</div>
        <% if (state === 'active') { %>
          <h2>Entrar na <em>equipe.</em></h2>
          <p class="sub"><%= invite.created_by_name || 'Um integrante' %> convidou você para participar de um Workspace no TaskFlow.</p>
          <div class="auth-card invite-card">
            <div class="invite-ws"><%- avatar({ name: invite.workspace_name, logo_path: invite.workspace_logo }, 'avatar-lg ws-logo') %><div><b><%= invite.workspace_name %></b><%- rolePill(invite.invited_role) %></div></div>
            <% if (maskedEmail) { %><div class="kv"><span><%- icon('mail') %>Enviado para</span><b><%= maskedEmail %></b></div><% } %>
            <div class="kv"><span><%- icon('clock') %>Validade</span><b><%= Number(invite.hours_left) >= 24 ? `${Math.floor(invite.hours_left / 24)} dia(s)` : `${Math.max(1, Number(invite.hours_left))} hora(s)` %></b></div>
            <% if (user) { %>
              <div class="kv"><span><%- icon('user') %>Sua conta</span><b><%= user.email %></b></div>
              <div class="step-nav">
                <form method="post" action="/invite/<%= encodeURIComponent(token) %>/decline"><button class="btn btn-ghost btn-block" type="submit"><%- icon('x','sm') %>Recusar</button></form>
                <form method="post" action="/invite/<%= encodeURIComponent(token) %>/accept"><button class="btn btn-primary btn-block" type="submit" data-loading-text="Entrando...">Aceitar convite<%- icon('arrow-right','sm') %></button></form>
              </div>
            <% } else { %>
              <div class="step-nav">
                <a class="btn btn-ghost" href="/register"><%- icon('user-plus','sm') %>Criar conta</a>
                <a class="btn btn-primary" href="/login">Entrar<%- icon('arrow-right','sm') %></a>
              </div>
              <div class="field-hint">Depois de entrar ou criar sua conta, você volta para esta página para confirmar o convite.</div>
            <% } %>
          </div>
        <% } else { %>
          <h2>Convite <em>indisponível.</em></h2>
          <div class="auth-banner <%= state === 'already_member' ? 'success-banner' : '' %>"><%- icon(state === 'already_member' ? 'check-circle' : 'alert','sm') %><%= message %></div>
          <% if (state === 'wrong_email' && user) { %><p class="sub">Você está conectado como <b><%= user.email %></b>.</p><% } %>
          <div class="step-nav">
            <% if (user) { %>
              <% if (state === 'wrong_email') { %><a class="btn btn-ghost" href="/logout"><%- icon('logout','sm') %>Trocar de conta</a><% } %>
              <a class="btn btn-primary" href="/dashboard">Ir para o painel<%- icon('arrow-right','sm') %></a>
            <% } else { %>
              <a class="btn btn-primary" href="/login">Entrar<%- icon('arrow-right','sm') %></a>
            <% } %>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</section>
<script src="/js/app.js"></script>
</body>
</html>
